# Copy to .env and fill in. .env is git-ignored. Never commit real keys.
# `python scripts/check_env.py` tells you what is set and, with --live, whether each key works.

# Nebius Token Factory (Nemotron Nano / Super / Ultra). Required for the AI deep read and PARSEC committee questions.
# Create one at https://studio.nebius.com (API keys).
NEBIUS_API_KEY=

# Tavily Search. Required for the public-source check on named companies.
# Create one at https://app.tavily.com
TAVILY_API_KEY=

# Optional: protect the paid /api/review/deep endpoint. When set, callers must send it as the X-Review-Token header
# (the Fine Print page asks for it as an "Access code").
REVIEW_API_TOKEN=

# Optional limits for /api/review/deep (defaults shown).
REVIEW_RATE_PER_MINUTE=6
REVIEW_DAILY_BUDGET_USD=2.0

# Optional: extra browser origins allowed to call the API, comma separated.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Where the deal folders live (one subfolder per deal). Default: ~/Deals
# DEALS_DIR=C:\Users\you\Deals

# Host names the server answers to (default 127.0.0.1, localhost, [::1]). Add yours when serving on a network.
# ALLOWED_HOSTS=127.0.0.1,localhost,my-server.example
